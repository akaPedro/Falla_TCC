<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/fundo_card_padrao">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txt_titulo_cores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cor dos Cards"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txt_subtitulo_cores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escolha uma categoria:"
            android:textSize="14sp"
            android:textColor="@color/texto_principal"
            android:alpha="0.7"
            android:layout_marginBottom="16dp" />

        <!-- Spinner de categorias -->
        <Spinner
            android:id="@+id/spinner_categoria_cor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/verde_fosco_header"
            android:layout_marginBottom="20dp" />

        <!-- Paleta de cores -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escolha uma cor:"
            android:textSize="14sp"
            android:textColor="@color/texto_principal"
            android:alpha="0.7"
            android:layout_marginBottom="12dp" />

        <GridLayout
            android:id="@+id/grid_paleta_cores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:layout_marginBottom="20dp" />

        <!-- Preview -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preview:"
            android:textSize="14sp"
            android:textColor="@color/texto_principal"
            android:alpha="0.7"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_preview_cor"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Exemplo de Card"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal" />

        </androidx.cardview.widget.CardView>

        <!-- Botões -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cores_cancelar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Cancelar"
                android:textSize="16sp"
                android:textColor="@color/texto_principal"
                android:alpha="0.6"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_cores_salvar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Aplicar"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/texto_header"
                android:background="@drawable/bg_botao_verde"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>