<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_sobre"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_principal"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/verde_fosco_header">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_voltar_sobre"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/seta"
            app:tint="@color/texto_header"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Sobre"
            android:textColor="@color/texto_header"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo central -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/appicon"
                android:scaleType="fitCenter"/>

            <!-- Nome e versão -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Falla"
                android:textColor="@color/texto_principal"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Versão 1.0"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:alpha="0.55"
                android:layout_marginBottom="32dp"/>

            <!-- Card: O que é o Falla -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/fundo_card_padrao"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_info_details"
                            android:layout_marginEnd="10dp"
                            app:tint="@color/verde_fosco_header"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="O que é o Falla?"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/texto_principal"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="O Falla é um aplicativo de Comunicação Aumentativa e Alternativa (CAA) desenvolvido para auxiliar pessoas não verbais — especialmente crianças e jovens no espectro autista — a se expressar com autonomia e dignidade."
                        android:textSize="15sp"
                        android:textColor="@color/texto_principal"
                        android:alpha="0.8"
                        android:lineSpacingMultiplier="1.5"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Como usar -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/fundo_card_padrao"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_help"
                            android:layout_marginEnd="10dp"
                            app:tint="@color/verde_fosco_header"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Como usar"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/texto_principal"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Toque em um card para o app falar a palavra ou frase em voz alta.\n\n• Toque e segure um card para editar, excluir ou favoritar.\n\n• Use o ícone de teclado no topo para digitar qualquer frase livremente.\n\n• Organize os cards por categorias e subcategorias usando as gavetas."
                        android:textSize="15sp"
                        android:textColor="@color/texto_principal"
                        android:alpha="0.8"
                        android:lineSpacingMultiplier="1.5"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: CAA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/card_sim_verde"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:layout_marginEnd="10dp"
                            app:tint="@color/verde_fosco_header"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Comunicação Aumentativa e Alternativa"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/texto_principal"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A CAA é um conjunto de recursos, estratégias e técnicas que complementam ou substituem a fala. Ela amplia a capacidade de comunicação de pessoas com dificuldades de expressão verbal, promovendo inclusão e qualidade de vida."
                        android:textSize="15sp"
                        android:textColor="@color/texto_principal"
                        android:alpha="0.85"
                        android:lineSpacingMultiplier="1.5"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Desenvolvido por -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/fundo_card_padrao"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_edit"
                            android:layout_marginEnd="10dp"
                            app:tint="@color/verde_fosco_header"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Desenvolvimento"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/texto_principal"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Desenvolvido como Trabalho de Conclusão de Curso (TCC).\n\nImagens pictográficas fornecidas pelo ARASAAC — Centro Aragonês de Comunicação Aumentativa e Alternativa, sob licença Creative Commons."
                        android:textSize="15sp"
                        android:textColor="@color/texto_principal"
                        android:alpha="0.8"
                        android:lineSpacingMultiplier="1.5"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>