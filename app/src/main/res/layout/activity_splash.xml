<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/verde_fosco_header">

    <!-- Logo / ícone central -->
    <ImageView
        android:layout_width="110dp"
        android:layout_height="112dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/appicon" />

    <!-- Nome do app -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Falla"
        android:textColor="@color/texto_header"
        android:textSize="48sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comunicação sem barreiras"
        android:textColor="@color/texto_header"
        android:textSize="16sp"
        android:alpha="0.75"
        android:layout_marginBottom="64dp"/>

    <!-- Barra de carregamento -->
    <ProgressBar
        android:id="@+id/progress_splash"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="180dp"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/texto_header"
        android:progressTint="@color/texto_header"/>

</LinearLayout>